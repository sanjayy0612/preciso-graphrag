# Copy this to .env and fill in your values.
# Never commit .env to git.

# Embeddings (pick one)
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=your-key-here

# LLM (pick one)
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Neo4j export (optional)
GRAPHRAG_NEO4J_URI=bolt://localhost:7687
GRAPHRAG_NEO4J_USERNAME=neo4j
GRAPHRAG_NEO4J_PASSWORD=
GRAPHRAG_NEO4J_DATABASE=neo4j

# Qdrant export (optional)
GRAPHRAG_QDRANT_URL=http://localhost:6333
GRAPHRAG_QDRANT_API_KEY=
GRAPHRAG_QDRANT_COLLECTION_PREFIX=preciso

# Shared export workspace label
GRAPHRAG_EXPORT_WORKSPACE=default
GRAPHRAG_EXPORT_CLEAR_EXISTING=false

# Ingest chunking (optional)
# Chunks longer than this are split into `-p1`, `-p2`, ... parts on ingest.
# Citations to the original chunk id are remapped to every part automatically.
GRAPHRAG_CHUNK_CHAR_LIMIT=800
GRAPHRAG_CHUNK_CHAR_OVERLAP=50

# Evidence integrity (optional)
# Every entity/relationship source_id should match a real chunk_id. By default a
# source_id matching no chunk is reported under `warnings` and still ingested.
# Set to true to reject those entities/relationships instead.
GRAPHRAG_STRICT_SOURCE_IDS=false
